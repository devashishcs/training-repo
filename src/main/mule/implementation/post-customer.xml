		<ee:transform doc:name="Submit Response" doc:id="f9acd435-17a3-420a-aa72-3665cab3c949" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
