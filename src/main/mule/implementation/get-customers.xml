			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="flowName" ><![CDATA["query-flow"]]></ee:set-variable>
				<ee:set-variable variableName="query" ><![CDATA["SELECT FIELDS(ALL) FROM Account WHERE Id = '" ++ vars.customerId ++ "'"]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="salesforce-request-connector-retry-flow " doc:id="2db9bd45-a681-4e15-b6ba-04f3dd555fce" name="salesforce-request-connector-retry-flow"/>
		<ee:transform doc:name="Submit Response" doc:id="ba7e74ab-f558-4984-8870-bb5ece4bbcf3" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</sub-flow>
</mule>
