    <flow name="post:\customers:application\json:test-evon-sf-sapi-config">
        <flow-ref doc:name="post-customers" doc:id="5f0024b7-f348-4663-b403-d315978ec860" name="post-customers" />
    </flow>
    <flow name="put:\customers\(customerId):application\json:test-evon-sf-sapi-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="customerId">attributes.uriParams.'customerId'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <logger level="INFO" message="Put Customers" />
    </flow>
    <flow name="get:\customers\(customerId):test-evon-sf-sapi-config">
        <ee:transform doc:name="Transform Message">
            <ee:variables>
                <ee:set-variable variableName="customerId">attributes.uriParams.'customerId'</ee:set-variable>
            </ee:variables>
        </ee:transform>
        <flow-ref doc:name="get-customers-by-id" doc:id="3ffd8a5f-e25d-4975-9a08-4687a5f751d4" name="get-customers-by-id" />
    </flow>
    <flow name="get:\customers:test-evon-sf-sapi-config">
        <flow-ref doc:name="Get Customers" doc:id="6c88cbfa-b700-4eae-a8d1-c74fb62ffc51" name="get-customers" />
    </flow>
</mule>
